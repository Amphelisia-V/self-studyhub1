<UserControl x:Class="self_studyhub.Pages.NotePage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Search & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="10" BorderBrush="#DDD" BorderThickness="1" Background="#FFFFFF">
                <TextBox Height="40"
                         Width="320"
                         Padding="10"
                         Text="Search"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Border>

            <Button Grid.Column="1"
                    Content="+ New Note" Click="NewNote_Click" 
                Height="40"
                    Padding="25,0"
                    Margin="10,0,0,0"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6A88" Offset="0"/>
                        <GradientStop Color="#FFB86C" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>

        <!-- Filter Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Border BorderBrush="#4F7DF3" BorderThickness="1.5" CornerRadius="10" Padding="15,6" Margin="0,0,10,0">
                <TextBlock Text="All Notes" Foreground="#4F7DF3" FontWeight="SemiBold"/>
            </Border>

            <ComboBox Width="200" Height="36" SelectedIndex="0">
                <ComboBoxItem Content="Recently Added"/>
            </ComboBox>

            <TextBlock Text="Sort by: Recently Added" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Notes Grid -->
        <ScrollViewer Grid.Row="2">
            <UniformGrid Columns="3" Margin="-10">

                <!-- Note Card Template -->
                <Border Background="White" CornerRadius="18" VerticalAlignment="Top" Margin="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="C# Syntax" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Using quotes, types, and best practices for clean and maintainable code." 
                                   Foreground="#777" TextWrapping="Wrap" 
                                  TextTrimming="CharacterEllipsis"
                                  MaxHeight="50"/>
                        <TextBlock Text="🕒 Apr 20 2024" FontSize="11" Foreground="#AAA"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="18" VerticalAlignment="Top" Margin="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="OOP Fundamentals" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Core principles of object-oriented programming explained simply." 
                                   Foreground="#777" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <TextBlock Text="🕒 Apr 18 2024" FontSize="11" Foreground="#AAA"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="18" VerticalAlignment="Top" Margin="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Common Coding Tips" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Practical tips to write better, cleaner, and safer code." 
                                   Foreground="#777" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <TextBlock Text="🕒 Apr 15 2024" FontSize="11" Foreground="#AAA"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </ScrollViewer>


        <!-- Slide Editor Overlay -->
        <Grid x:Name="EditorOverlay"
      Background="#80000000"
      Visibility="Collapsed">

            <Grid HorizontalAlignment="Right" Width="600">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="EditorTransform" X="600"/>
                </Grid.RenderTransform>

                <Border Background="White"
                CornerRadius="25,0,0,25"
                Padding="25">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="B" Width="35"/>
                                <Button Content="I" Width="35" Margin="5,0"/>
                                <Button Content="•" Width="35"/>
                            </StackPanel>

                            <Button Content="Save"
                            DockPanel.Dock="Right"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Width="80"
                            Height="35"/>
                        </DockPanel>

                        <!-- Title -->
                        <TextBox x:Name="NoteTitleBox"
                         Grid.Row="1"
                         FontSize="20"
                         FontWeight="Bold"
                         Margin="0,20,0,10"
                         Text="Untitled Note"/>

                        <!-- Content -->
                        <TextBox x:Name="NoteContentBox"
                         Grid.Row="2"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontSize="14"/>

                        <!-- Close Button -->
                        <Button Grid.Row="3"
                        Content="Close"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0"
                        Click="CloseEditor_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>