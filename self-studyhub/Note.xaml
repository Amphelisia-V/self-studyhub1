<UserControl x:Class="self_studyhub.Pages.NotePage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialDesignControls="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"

             Background="#121212">
    <Grid >
        <Grid.Background>
            <ImageBrush ImageSource="/Assests/background2.jpg"
                    Stretch="UniformToFill"
                    Opacity="0.8"/>
        </Grid.Background>
        <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="388*"/>
            <ColumnDefinition Width="277*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,10,30,10" Grid.ColumnSpan="2"
        >



            <DockPanel Height="60" VerticalAlignment="Top" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="left" VerticalAlignment="Center">
                    <Image Source="D:\4CS\Project\app_logo\logo2.jpg"
               Width="40"
               Height="40"
               Margin="0,0,10,0"/>
                    <TextBlock Text="StudyControl" FontSize="24" FontWeight="Bold" Foreground="White"  />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Level 
                    <Border Background="#FF2E2E2E" CornerRadius="5" Padding="5" Height="40" Margin="0,0,10,0">
                        <TextBlock Text="Level 3"  VerticalAlignment="Top" Foreground="White" Margin="0,17,0,0"/>
                    </Border>-->

                    <!-- Study Streak -->
                   


                </StackPanel>
            </DockPanel>
        </Grid>
        <!-- Top Search & Action Bar -->
        <Grid Grid.Row="1" Margin="200,0,200,20" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="139*"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border 
                Height="48"
                    CornerRadius="24"
                    Background="#2A2A2A"
                    Padding="15,0" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal"
Margin="10">
                    <TextBox 
         materialDesign:HintAssist.Hint="Search your notes"
         Background="Transparent"
         BorderThickness="0"
         Foreground="White"
         FontSize="16"
         VerticalContentAlignment="Center"/>

                </StackPanel>
            </Border>
            <Button Grid.Column="2"
                    Content="+ New Note" Click="NewNote_Click" 
                Height="40"
                    Padding="25,0"
                    Margin="10,4,0,4"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6A88" Offset="0"/>
                        <GradientStop Color="#FFB86C" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>

        <!-- Filter Row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,20" >
            <Border BorderBrush="#4F7DF3" BorderThickness="1.5" CornerRadius="10" Padding="15,6" Margin="0,0,10,0">
                <TextBlock Text="All Notes" Foreground="#4F7DF3" FontWeight="SemiBold"/>
            </Border>

            <ComboBox Width="200" Height="36" SelectedIndex="0" Foreground="White">
                <ComboBoxItem Content="Recently Added"
                             Foreground="Black" />
            </ComboBox>

            <TextBlock Text="Sort by: Recently Added" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Notes Grid -->
        <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2">
            <UniformGrid x:Name="NotesContainer"
            Columns="3"
            Margin="10">

                <!-- Note Card Template -->
                <Border Background="White" CornerRadius="18" VerticalAlignment="Top" Margin="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="C# Syntax" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Using quotes, types, and best practices for clean and maintainable code." 
                                   Foreground="#777" TextWrapping="Wrap" 
                                  TextTrimming="CharacterEllipsis"
                                  MaxHeight="50"/>
                        <TextBlock Text="🕒 Apr 20 2024" FontSize="11" Foreground="#AAA"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="18" VerticalAlignment="Top" Margin="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="OOP Fundamentals" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Core principles of object-oriented programming explained simply." 
                                   Foreground="#777" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <TextBlock Text="🕒 Apr 18 2024" FontSize="11" Foreground="#AAA"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="18" VerticalAlignment="Top" Margin="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Common Coding Tips" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Practical tips to write better, cleaner, and safer code." 
                                   Foreground="#777" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <TextBlock Text="🕒 Apr 15 2024" FontSize="11" Foreground="#AAA"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </ScrollViewer>


        <!-- Slide Editor Overlay -->
        <Grid x:Name="EditorOverlay"
      Background="#80000000"
      Visibility="Collapsed" Grid.ColumnSpan="2" Margin="0,0,0,68" Grid.RowSpan="2">

            <Grid HorizontalAlignment="Right" Width="600">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="EditorTransform" X="600"/>
                </Grid.RenderTransform>

                <Border Background="white"
                CornerRadius="25,0,0,25"
                Padding="25">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Title -->
                        <TextBox x:Name="NoteTitleBox"
                         Grid.Row="1"
                         FontSize="20"
                         FontWeight="Bold"
                         Margin="0,20,0,10"
                         Text="Untitled Note"/>

                        <!-- Content -->
                        <TextBox x:Name="NoteContentBox"
                         Grid.Row="2"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontSize="14"/>

                        <!-- Close Button -->
                        <Button Grid.Row="3"
                        Content="Close"
                        HorizontalAlignment="Left"
                        Margin="0,15,0,0"
                        Click="CloseEditor_Click"/>


                        <!--save-->
                        <Button Grid.Row="3"
                        Content="Save"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0"
        Click="SaveNote_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>