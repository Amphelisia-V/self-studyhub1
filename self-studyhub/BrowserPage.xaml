<UserControl x:Class="self_studyhub.Pages.BrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
              
             Background="#121212">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <!-- FIRST SCREEN : CUSTOM SEARCH UI -->
            <StackPanel x:Name="SearchPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="600">

                <!-- Logo / Title -->
                <TextBlock Text="MyBrowser"
                       FontSize="48"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

                <!-- Search Bar -->
                <Border Height="48"
                    CornerRadius="24"
                    Background="#2A2A2A"
                    Padding="15,0">

                    <TextBox x:Name="SearchBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         FontSize="16"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"
                         Text="Search Google or type a URL"/>
                </Border>
            </StackPanel>


            <!-- WEB BROWSER -->
            <wv2:WebView2 x:Name="MyBrowser"
                      Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="1">
            <!-- SHORTCUTS -->
            <!-- SHORTCUTS (CIRCLE) -->
            <!-- SHORTCUTS -->
            <WrapPanel x:Name="ShortcutPanel"
           Margin="0,30,0,0"
           HorizontalAlignment="Center">
                <!-- Add Shortcut Card -->
                <Border Width="110" Height="110"
            CornerRadius="14"
            Background="#2A2A2A"
            Margin="8"
            Cursor="Hand"
            MouseLeftButtonUp="AddShortcut_Click">
                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                        <TextBlock Text="+"
                       FontSize="36"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
                        <TextBlock Text="Add shortcut"
                       FontSize="12"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Add Shortcut Card -->

                <!-- Add Shortcut Card -->

            </WrapPanel>





        </Grid>
    </Grid>
</UserControl>
