<Window x:Class="self_studyhub.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:self_studyhub"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Login" 
        Height="500"
        Width="900" 
        
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#121212">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
        CornerRadius="20,0,0,20"
        Background="WhiteSmoke">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="300">

                <TextBlock Text="STUDENT LOGIN"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1E1E1E"
                           Margin="0,0,0,30"/>

                <!-- Email -->
                <TextBox x:Name="txtEmail"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                
                         Height="45"
                         Margin="0,10"
                         Padding="13"
                         Background="MidnightBlue"
                         materialDesign:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Password With Eye -->
                <Grid Height="45" Margin="0,10">

                    <Border CornerRadius="15"
            Background="MidnightBlue">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Password -->
                            <PasswordBox x:Name="txtPassword"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="13,0,0,0"
                         Foreground="White"
                         FontSize="16"
                         VerticalContentAlignment="Center"
                          materialDesign:HintAssist.Hint="Password"
 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                            

                            <!-- Visible Password -->
                            <TextBox x:Name="txtPasswordVisible"
                     Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="13,0,0,0"
                     Foreground="White"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                      materialDesign:HintAssist.Hint="Password"
 Style="{StaticResource MaterialDesignOutlinedTextBox}" 

                            Visibility="Collapsed"/>

                            <!-- Eye Button -->
                            <Button Grid.Column="1"
                    Click="TogglePassword_Click"
                    Background="Transparent"
                  BorderThickness="0"
                    Cursor="Hand">

                                <materialDesign:PackIcon x:Name="eyeIcon"
                                         Kind="EyeOutline"
                                         Width="18"
                                         Height="18"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"/>
                            </Button>

                        </Grid>
                    </Border>
                </Grid>

                <!-- Login Button -->
                <Button Content="LOGIN"
                        Height="45"
                        Margin="0,20,0,0"
                        Click="Login_Click"
                        Background="#1A237E"
                        Foreground="White"
                        FontWeight="Bold"
                       Style="{StaticResource MaterialDesignRaisedButton}"/>

                <TextBlock Text="New User? Create an account"
                           Foreground="Gray"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" Background="Transparent">

            <Image Source="Assests/login.jpg"
                   Stretch="Fill"/>

        </Grid>
    </Grid>
</Window>
