<Window x:Class="self_studyhub.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:self_studyhub"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="Window_Loaded"
    Title="Login" 
        Height="500"
        Width="900" 
        
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#121212">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
        CornerRadius="20,0,0,20"
        Background="WhiteSmoke">

            <StackPanel x:Name="loginPanel"
            Opacity="0"
            Margin="0,5,0,25"
            VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="300">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="40"/>
                </StackPanel.RenderTransform>

                <TextBlock Text="Study Control"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E1E1E"
                           Margin="30,10,0,30"/>
                <StackPanel HorizontalAlignment="Center" Margin="0,5,0,25">

                    <TextBlock Text="Welcome back, future achiever!"
               FontSize="21"
               FontWeight="SemiBold"
               Foreground="#1A237E"
               HorizontalAlignment="Center"/>

                    <TextBlock Text="Every lesson you complete brings you closer to success."
               FontSize="15"
               Foreground="#333333"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Width="280"/>

                </StackPanel>
                <!-- Email -->
                <TextBox x:Name="txtEmail"
                FontSize="16"
                FontWeight="SemiBold"
                         Height="45"
                         Padding="12,8"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         materialDesign:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Password With Eye -->
                <Grid Height="45" Margin="0,10">

                    <!-- PasswordBox -->
                    <PasswordBox x:Name="txtPassword"
                 FontSize="16"
                 FontWeight="SemiBold"
                 
                 Height="45"
                 VerticalAlignment="Center"
                 Background="Transparent"
                 materialDesign:HintAssist.Hint="Password"
                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                 Padding="12,8,45,8"/>


                    <!-- Visible Password -->
                    <TextBox x:Name="txtPasswordVisible"
             FontSize="16"
             FontWeight="SemiBold"
             Height="45"
             Padding="12,8,45,8"
             VerticalAlignment="Center"
             Foreground="Black"
             Background="Transparent"
             materialDesign:HintAssist.Hint="Password"
             Style="{StaticResource MaterialDesignOutlinedTextBox}"
             Visibility="Collapsed"/>


                    <!-- Eye Icon Inside Box -->
                    <Button HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Width="40"
        Height="40"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        Focusable="False"
        IsTabStop="False"
        Click="TogglePassword_Click"
        Cursor="Hand">
                        <materialDesign:PackIcon x:Name="eyeIcon"
                                 Kind="EyeOutline"
                                 Width="22"
                                 Height="22"
                                 Foreground="Black"/>

                    </Button>

                </Grid>

                <!-- Login Button -->
                <Button Content="LOGIN"
                        Height="45"
                        Margin="0,20,0,0"
                        Click="Login_Click"
                        Background="#0F1E5A"
                        Foreground="White"
                        FontWeight="Bold"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="15"/>

                <Button Content=" Create an account"
        Background="Transparent"
        BorderThickness="0"
        Foreground="#1A237E"
        Cursor="Hand"
        Margin="0,20,0,0"
        HorizontalAlignment="Center"
        Click="OpenRegister_Click"/>
                <Button Content=" forgot password?"
        Background="Transparent"
        BorderThickness="0"
        Foreground="#1A237E"
        Cursor="Hand"
        Margin="65,20,95,0"
        HorizontalAlignment="Center"
                         Click="Forgotpw_Click"
        />
            </StackPanel>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" Background="Transparent">

            <Image Source="Assests/login.jpg"
                   Stretch="Fill"/>

        </Grid>
    </Grid>
</Window>
