<Window x:Class="self_studyhub.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:self_studyhub"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="Window_Loaded"
    Title="Login" 
        Height="500"
        Width="900" 
        
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#121212">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
        CornerRadius="20,0,0,20"
        Background="WhiteSmoke">

            <StackPanel x:Name="loginPanel"
            Opacity="0"
            Margin="0,5,0,25"
            VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="300">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="40"/>
                </StackPanel.RenderTransform>

                <TextBlock Text="STUDENT LOGIN"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1E1E1E"
                           Margin="0,0,0,30"/>
                <StackPanel HorizontalAlignment="Center" Margin="0,5,0,25">

                    <TextBlock Text="Welcome back, future achiever!"
               FontSize="21"
               FontWeight="SemiBold"
               Foreground="#1A237E"
               HorizontalAlignment="Center"/>

                    <TextBlock Text="Every lesson you complete brings you closer to success."
               FontSize="15"
               Foreground="#333333"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Width="280"/>

                </StackPanel>
                <!-- Email -->
                <TextBox x:Name="txtEmail"
                FontSize="16"
                FontWeight="SemiBold"
              
                
                
                         Height="45"
                         Margin="0,10"
                         Padding="13"
                         Background="#3A8FA0"
                         materialDesign:HintAssist.Hint="Email"
                        
                      
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Password With Eye -->
                <Grid Height="45" Margin="0,10">

                    <!-- PasswordBox -->
                    <PasswordBox x:Name="txtPassword"
                    Grid.Column="0"
                 FontSize="16"
                 FontWeight="SemiBold"
                 
                 Background="#3A8FA0"
                 Padding="13,0,0,0"
                 materialDesign:HintAssist.Hint="Password"
               
                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />


                    <!-- Visible Password -->
                    <TextBox x:Name="txtPasswordVisible"
                    Grid.Column="0"
             FontSize="16"
             FontWeight="SemiBold"
             Foreground="White"
             Background="#3A8FA0"
             Padding="13,0,0,0"
         
             materialDesign:HintAssist.Hint="Password"
             Style="{StaticResource MaterialDesignOutlinedTextBox}"
             Visibility="Collapsed"/>

                    <!-- Eye Button (Overlay) -->
                    <Button HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Grid.Column="1"
            Background="Transparent"
            BorderThickness="0"
            Click="TogglePassword_Click"
            Cursor="Hand"
            Panel.ZIndex="1">

                        <materialDesign:PackIcon x:Name="eyeIcon"
                                 Kind="EyeOutline"
                                 Width="20"
                                 Height="20"
                                 Foreground="White"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Padding="13,0,0,0"/>
                    </Button>

                </Grid>

                <!-- Login Button -->
                <Button Content="LOGIN"
                        Height="45"
                        Margin="0,20,0,0"
                        Click="Login_Click"
                        Background="#0F1E5A"
                        Foreground="White"
                        FontWeight="Bold"
                       Style="{StaticResource MaterialDesignRaisedButton}"/>

                <TextBlock Text="New User? Create an account"
                           Foreground="Gray"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" Background="Transparent">

            <Image Source="Assests/login.jpg"
                   Stretch="Fill"/>

        </Grid>
    </Grid>
</Window>
