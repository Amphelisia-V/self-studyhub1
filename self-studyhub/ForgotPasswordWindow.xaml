<Window x:Class="self_studyhub.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Password"
        Height="350"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5">
        <StackPanel Width="250"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">


            <TextBlock Text="Forgot Password"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>


            <!-- STEP 1 -->
            <StackPanel x:Name="Step1">

                <TextBlock Text="Email"/>

                <TextBox x:Name="txtEmail"
                         Height="30"
                         Margin="0,5,0,15"/>


                <Button Content="Send OTP"
                        Height="35"
                        Click="SendOTP_Click"/>

            </StackPanel>



            <!-- STEP 2 -->
            <StackPanel x:Name="Step2"
                        Visibility="Collapsed">

                <TextBlock Text="Enter OTP"/>

                <TextBox x:Name="txtOTP"
                         Height="30"
                         Margin="0,5,0,15"/>


                <Button Content="Verify OTP"
                        Height="35"
                        Click="VerifyOTP_Click"/>

            </StackPanel>



            <!-- STEP 3 -->
            <StackPanel x:Name="Step3"
                        Visibility="Collapsed">


                <TextBlock Text="New Password"/>

                <PasswordBox x:Name="txtNewPassword"
                             Height="30"
                             Margin="0,5,0,10"/>


                <Button Content="Reset Password"
                        Height="35"
                        Click="ResetPassword_Click"/>


            </StackPanel>


            <Button Content="Back to Login"
                    Margin="0,20,0,0"
                    Click="BackToLogin_Click"/>


        </StackPanel>


    </Grid>
</Window>