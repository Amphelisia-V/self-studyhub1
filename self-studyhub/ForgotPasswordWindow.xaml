<Window x:Class="self_studyhub.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Password"
        Height="350"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5">

        <StackPanel Width="250"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Forgot Password"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <!-- Username -->
            <TextBlock Text="Enter Your UserName"/>
            <TextBox x:Name="txtUsername"
                     Height="30"
                     Margin="0,5,0,10"/>

            <!-- Secret Question -->
            

            <!-- Answer -->
            <TextBlock Text="Enter Your Email"/>
            <TextBox x:Name="txtEmail"
                     Height="30"
                     Margin="0,5,0,20"/>

            <!-- Reset Button -->
            <Button Content="Reset Password"
                    Height="35"
                    Click="ResetPassword_Click"
                    Background="#673AB7"
                    Foreground="White"/>

            <!-- Back -->
            <Button Content="Back to Login"
                    Margin="0,10,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="Blue"
                    Click="BackToLogin_Click"/>

        </StackPanel>

    </Grid>
</Window>