<UserControl x:Class="self_studyhub.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

            <Grid.Background>
            <ImageBrush ImageSource="/Assests/background2.jpg"
                    Stretch="UniformToFill"
                    Opacity="0.8"/>
        </Grid.Background>

            <!-- Columns -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <!-- HEADER -->
            <RowDefinition Height="90"/>
            <!-- SEARCH -->
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Margin="30,10,30,0"
        HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="StudyControl"
               FontSize="26"
               FontWeight="Bold"
               Foreground="White"
               VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Border Background="#1F2937"
                CornerRadius="15"
                Padding="10,5"
                Margin="0,0,15,0">
                    <TextBlock Text="🔥 5 Days"
                       Foreground="White"/>
                </Border>

                <Border Background="#1F2937"
                CornerRadius="15"
                Padding="10,5">
                    <TextBlock Text="🔔"/>
                </Border>

            </StackPanel>
        </Grid>
        <!-- ================= SEARCH ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
        Margin="30,10,0,0"
        Width="500"
        Height="45"
        Background="#1C1F2B"
        CornerRadius="20"
        Padding="10">

            <DockPanel>

                <TextBlock Text="🔍"
                   FontSize="16"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"/>

                <TextBox Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 FontSize="14"
                 Text="Search tasks, notes, videos..."
                 CaretBrush="White"/>
            </DockPanel>
        </Border>




        <!-- ================= DAILY GOAL CARD ================= -->
        <Grid x:Name="DailyGoalContainer"></Grid>
        <Border Grid.Row="2"
                Grid.Column="0"
               Background="#1E293B"
        CornerRadius="20"
        Padding="20"
        Margin="15">


            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Daily Goal"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                <!-- Progress Bar Container -->
                <Grid Height="28"
                ClipToBounds="True"
                x:Name="DailyGoalProgressContainer"
                SizeChanged="DailyGoalProgressContainer_SizeChanged">

                    <!-- Background -->
                    <Border Background="#334155"
                    CornerRadius="8"/>

                    <!-- Progress Fill -->
                    <Border x:Name="DailyGoalBar"
                    Background="#38BDF8"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale"
                        ScaleX="0"
                        CenterX="0"/>
                        </Border.RenderTransform>
                    </Border>
                    <!-- Center Text -->
                    <TextBlock x:Name="DailyGoalText"
                      
                       Foreground="White"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Grid>

                <!-- Bottom Info -->
                <TextBlock x:Name="DailyGoalInfo"
                   Text="2 tasks left to complete today's goal"
                   Foreground="#94A3B8"
                   FontSize="12"
                   Margin="0,12,0,0"/>

            </StackPanel>
        </Border>

        <!-- ================= FOCUS TIMER ================= -->
        <Border Grid.Row="3"
        Grid.Column="1"
         Background="#1E1E1E"
        CornerRadius="15"
        Padding="20"
        Width="300"
        Height="200">


            <StackPanel HorizontalAlignment="Center"
            VerticalAlignment="Center">




                <!-- Title -->
                <TextBlock Text="Focus Timer"
                   Foreground="AntiqueWhite"
                   FontSize="20"
                   HorizontalAlignment="Center"
                 />

                <!-- Big Timer -->
                <TextBlock x:Name="TimerText"
                   Text="25:00"
                   
                   FontSize="50"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   TextWrapping="NoWrap"
                   Width="auto"/>

                <!--time button-->
                <StackPanel Orientation="Horizontal"
                   HorizontalAlignment="Center">
                    <!-- Start Button -->

                <Button x:Name="StartButton"
                Content="START"
                Width="80"
                Height="35"
                FontSize="12"
                FontWeight="Bold"
                Background="#FF5A5F"
                Foreground="White"
                BorderThickness="0"
                Click="StartTimer"
                Cursor="Hand"
                />

                <!-- reset Button -->
                <Button x:Name="ResetButton"
Content="RESET"
Width="80"
Height="35"
FontSize="12"
FontWeight="Bold"
Background="#FF5A5F"
Foreground="White"
BorderThickness="0"
Click="ResetTimer"
Cursor="Hand"
/>
            </StackPanel>
            </StackPanel>
        </Border>
        <!-- ================= SKILL PROGRESS ================= -->
        <Border Grid.Row="3"
        Grid.Column="0"
        Margin="0,10,0,10"
        Background="#141821"
        CornerRadius="20"
        Padding="25">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="Skill Progress"
                   Foreground="White"
                   FontSize="18"
                   Margin="0,0,0,15"/>

                <Grid Width="140" Height="140"
                ClipToBounds="False">

                    <!-- Background Circle -->
                    <Ellipse Stroke="#2A2F3A"
                     StrokeThickness="10"/>

                    <!-- Progress Arc -->
                    <Path x:Name="ProgressArc"
                  Stroke="#4FC3F7"
                  StrokeThickness="10"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

                    <!-- Center Text -->
                    <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock x:Name="XpText"
                           Text="60 XP"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                        <TextBlock Text="Level 3"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </StackPanel>
        </Border>
        <!-- ================= TODAY TASKS ================= -->
        <Border Grid.Row="2"
                Grid.Column="1"
                Margin="15,20,30,15"
                Background="#141821"
                CornerRadius="15"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Today Tasks"
                           Foreground="White"
                           FontSize="18"/>
                <ListBox x:Name="TaskList"
                         Grid.Row="1"
                         Background="#1C1F2B"
                         BorderThickness="0"
                         Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding}"
                      FontSize="14"
                      Margin="5"
                      Cursor="Hand"
                      Foreground="White"
                      Checked="Task_Checked"
                      Unchecked="Task_Unchecked"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="+"
                        Width="30"
                        Height="30"
                        FontSize="20"
                        Background="#7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Click="OpenTaskModal"/>
            </Grid>
        </Border>

        <!-- ================= MODAL OVERLAY ================= -->
        <Grid x:Name="TaskModalOverlay"
        MouseDown="CloseTaskModal"
              Grid.RowSpan="4"
              Grid.ColumnSpan="2"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="999">

            <Border Width="380"
                    Background="#1C1F2B"
                    CornerRadius="20"
                    Padding="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Manage Task"
                               Foreground="White"
                               FontSize="18"
                               Margin="0,0,0,15"/>

                    <TextBox x:Name="TaskNameBox"
                             Height="40"
                             Background="#2A2F3A"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="10"
                             Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Delete"
                                Background="#DC2626"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Click="DeleteTask"/>

                        <Button Content="Save"
                                Background="#7C3AED"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Click="SaveTask"/>

                        <Button Content="Close"
                                Background="#374151"
                                Foreground="White"
                                Click="CloseTaskModal"/>
                    </StackPanel>

                </StackPanel>
            </Border>
          
        </Grid>
        <Grid x:Name="CustomMessage"
        Grid.RowSpan="4"
        Grid.ColumnSpan="2"
      Visibility="Collapsed"
      Background="#80000000"
      Panel.ZIndex="1000">

            <Border Width="300"
            Background="#1C1F2B"
            CornerRadius="15"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock x:Name="MessageTitle"
                       Text="Success!"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#4ADE80"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>

                    <TextBlock x:Name="MessageText"
                       Text="Task Completed!"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

                    <Button Content="OK"
                    Width="80"
                    Background="#7C3AED"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseCustomMessage"/>
                </StackPanel>

            </Border>
        </Grid>
    </Grid>
</UserControl>