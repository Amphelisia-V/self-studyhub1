<UserControl x:Class="self_studyhub.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        >
    <Grid Height="70" Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Side Title -->
        <TextBlock Text="StudyControl"
               FontSize="26"
               FontWeight="Bold"
               Foreground="White"
               VerticalAlignment="Center"
               Margin="20,0,0,0"/>

        <!-- Right Side Section -->
        <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,20,0">

            <!-- Streak Box -->
            <Border Background="#2A2A2A"
                CornerRadius="10"
                Padding="10,5"
                Margin="0,0,10,0">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔥"
                           FontSize="16"
                           Margin="0,0,5,0"/>
                    <TextBlock Text="5 Days"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Notification Button -->
            <Button Width="40"
                Height="40"
                Background="#2A2A2A"
                BorderBrush="#444"
                BorderThickness="1"
                Cursor="Hand">

                <TextBlock Text="🔔"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
        
