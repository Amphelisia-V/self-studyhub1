<UserControl x:Class="self_studyhub.Pages.PDFPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">
    <Grid Margin="40">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">

            <!-- Title -->
            <TextBlock Text="PDF Viewer"
                       FontSize="28"
                       Foreground="White"
                       FontWeight="SemiBold"
                       Margin="0,0,0,30"/>

            <!-- Open PDF -->
            <Button Content="Open a PDF file"
                    Height="45"
                    FontSize="16"
                    Background="#2D2D30"
                    Foreground="White"
                    BorderBrush="#3E3E42"
                    Margin="0,0,0,15"/>

            <!-- Open Recent -->
            <Button Content="Open a recent file"
                    Height="45"
                    FontSize="16"
                    Background="#2D2D30"
                    Foreground="White"
                    BorderBrush="#3E3E42"
                    Margin="0,0,0,30"/>

            <!-- Get Started -->
            <TextBlock Text="Get Started"
                       FontSize="18"
                       Foreground="#C5C5C5"
                       Margin="0,0,0,10"/>

            <TextBlock Text="• Annotate PDF"
                       Foreground="#9CDCFE"
                       FontSize="14"
                       Margin="0,5"/>

            <TextBlock Text="• Extract Pages"
                       Foreground="#9CDCFE"
                       FontSize="14"
                       Margin="0,5"/>

        </StackPanel>

        <!-- RIGHT SIDE (Recent Files) -->
        <StackPanel Grid.Column="1"
                    Margin="40,0,0,0">

            <TextBlock Text="Recent"
                       FontSize="20"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <ListBox Background="#252526"
                     BorderBrush="#3E3E42"
                     Foreground="White"
                     Height="300">

                <ListBoxItem Content="ProjectPlan.pdf"/>
                <ListBoxItem Content="StudyGuide.pdf"/>
                <ListBoxItem Content="Notes123.pdf"/>
                <ListBoxItem Content="ResearchPaper.pdf"/>

            </ListBox>

        </StackPanel>

    </Grid>
</UserControl>
