<UserControl x:Class="self_studyhub.Pages.YouTubePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialDesignControls="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
            
             Background="#121212"
             >
    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"></RowDefinition>
            <!--header-->
            <RowDefinition Height="*"></RowDefinition>
            <!--logo-->
            <RowDefinition Height="Auto"></RowDefinition>
            <!--search-->
            <RowDefinition Height="Auto"></RowDefinition>
            <!--button-->
            <RowDefinition Height="Auto"></RowDefinition>
            <!--footer-->
        </Grid.RowDefinitions>
        <!--Header-->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="20"></ColumnDefinition>
                <ColumnDefinition Width="700"></ColumnDefinition>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>

            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0"
                        Text="StudyControl"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                       VerticalAlignment="Center"
                   HorizontalAlignment="Center" Grid.ColumnSpan="2" Margin="0,12,19,12"
                      
                  ></TextBlock>
            <!--<TextBlock Grid.Column="1"
                       Text="🔍"
                       FontSize="18"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="White"></TextBlock>-->
            <Border Grid.Column="2" 
                Height="48"
                    
                    CornerRadius="24"
                    Background="#2A2A2A"
                    Padding="15,0"
                    Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal"
Margin="10">
                    <TextBox x:Name="youtubelinkbox"
         materialDesign:HintAssist.Hint="Paste YouTube link"
         Background="Transparent"
         BorderThickness="0"
         Foreground="White"
         FontSize="16"
         VerticalContentAlignment="Center"/>

                </StackPanel>
            </Border>
            <Button Content="Load" Grid.Column="4"
                            Margin="0,8,100,8" 
                   Foreground="White"
                            Click="LoadVideo_Click" Height="32" VerticalAlignment="Center">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6A88" Offset="0"/>
                        <GradientStop Color="#FFB86C" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>

            </Grid.ColumnDefinitions>
            <wv2:WebView2 x:Name="VideoView"
                          Grid.Column="0"
                          
                          Margin="10">
            </wv2:WebView2>
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Background="Gray">

            </GridSplitter>

            <Border Grid.Column="1">
                <StackPanel Margin="10">

                    <!-- ================= TODAY TASK ================= -->



                    <!-- ================= NOTES ================= -->
                    <TextBlock Text="My Notes"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,8"/>

                    <TextBox x:Name="NoteBox"
                 Height="180"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Foreground="White"
                 Background="#1E1E1E"
                 materialDesign:HintAssist.Hint="Write your note here"
                 Margin="0,0,0,8"/>

                    <Button Content="Save Note"
                Width="100"
                HorizontalAlignment="Right"
                >
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6A88" Offset="0"/>
                                <GradientStop Color="#FFB86C" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <!-- Divider -->
                    <Separator Margin="0,12,0,12"/>

                    <!-- Task List with Checkbox -->
                    <ListBox x:Name="TaskList"
         Height="140"
         Background="#1E1E1E"
         BorderThickness="0">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding}"
                      Foreground="White"
                      FontSize="14"
                      Margin="4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>


                </StackPanel>
            </Border>
        </Grid>

    </Grid>


</UserControl>
