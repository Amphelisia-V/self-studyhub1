<UserControl x:Class="self_studyhub.Pages.YouTubePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialDesignControls="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
            
             Background="#121212"
             >
    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"></RowDefinition>
            <!--header-->
            <RowDefinition Height="*"></RowDefinition>
            <!--logo-->
            <RowDefinition Height="Auto"></RowDefinition>
            <!--search-->
            <RowDefinition Height="Auto"></RowDefinition>
            <!--button-->
            <RowDefinition Height="Auto"></RowDefinition>
            <!--footer-->
        </Grid.RowDefinitions>
        <!--Header-->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>

            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0"
                        Text="Google"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                      
                  ></TextBlock>
            <!--<TextBlock Grid.Column="1"
                       Text="🔍"
                       FontSize="18"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="White"></TextBlock>-->
            <Border Grid.Column="2"
                Height="48"
                    CornerRadius="24"
                    Background="#2A2A2A"
                    Padding="15,0">
                <StackPanel Orientation="Horizontal"
Margin="10">
                    <TextBox x:Name="youtubelinkbox"
         materialDesign:HintAssist.Hint="Paste YouTube link"
         Background="Transparent"
         BorderThickness="0"
         Foreground="White"
         FontSize="16"
         VerticalContentAlignment="Center"/>
                    
                </StackPanel>
                            </Border>
            <Button Content="Load" Grid.Column="3"
                            Margin="0,0,10,0"
                            Click="LoadVideo_Click" Height="32" VerticalAlignment="Top"/>


        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                
            </Grid.ColumnDefinitions>
            <wv2:WebView2 x:Name="VideoView"
                          Grid.Column="0"
                          
                          Margin="10">
            </wv2:WebView2>
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Background="Gray">

            </GridSplitter>

            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="My Notes" FontSize="16" FontWeight="Bold"/>
                <TextBox Height="200" AcceptsReturn="True"/>
            </StackPanel>
        </Grid>

    </Grid>


</UserControl>
