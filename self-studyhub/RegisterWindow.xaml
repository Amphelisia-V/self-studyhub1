<Window x:Class="self_studyhub.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Register"
            Loaded="Window_Loaded"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="25"
        Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                      ShadowDepth="5"
                      Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- 2 Columns -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDE (ROCKET IMAGE) ================= -->
            <Image Grid.Column="0"
               Source="/Assests/signup1.jpg"
               Stretch="Fill"/>


            <!-- ================= RIGHT SIDE (FORM) ================= -->
            <Border Grid.Column="1"
                Background="#F5F5F5"
                CornerRadius="0,20,20,0">

                <StackPanel
                 x:Name="SignUpPanel"
 Opacity="0"
 Margin="0,5,0,25"
 VerticalAlignment="Center"
             HorizontalAlignment="Center"
             Width="300">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="40"/>
                        </StackPanel.RenderTransform>
                        <!-- Title -->
                    <TextBlock Text="CREATE ACCOUNT"
                           FontSize="20 "
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
                    <StackPanel HorizontalAlignment="Center" Margin="0,5,0,25">
                        <TextBlock Text="Lunch your learning journey"
FontSize="23"
Margin="0,10"
TextWrapping="Wrap"
FontWeight="SemiBold"
Foreground="DarkSlateBlue"
HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Your future starts here"
FontSize="18"
Foreground="#673AB7"
TextAlignment="Center"
TextWrapping="Wrap"
Width="280"/>
                    </StackPanel>
                    <!-- Full Name -->
                    <Border CornerRadius="12"
                        Background="White"
                        Margin="0,10">

                        <TextBox x:Name="txtName" Height="45"
                             Padding="10"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Background="Transparent"
                             BorderThickness="0"
                             materialDesign:HintAssist.Hint="Full Name"
                             Style="{StaticResource MaterialDesignFilledTextBox}"/>
                    </Border>

                    <!-- Email -->
                    <Border CornerRadius="12"
                        Background="White"
                        Margin="0,10">

                        <TextBox x:Name="txtEmail" Height="45"
                             Padding="10"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Background="Transparent"
                             BorderThickness="0"
                             materialDesign:HintAssist.Hint="Email"
                             Style="{StaticResource MaterialDesignFilledTextBox}"/>
                    </Border>

                    <!-- Password -->
                    <Border CornerRadius="12"
                        Background="White"
                        Margin="0,10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Password -->
                            <PasswordBox x:Name="txtPassword"
                 Grid.Column="0"
                 Height="45"
                 Padding="10"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Background="Transparent"
                 BorderThickness="0"
                 materialDesign:HintAssist.Hint="Password"
                 Style="{StaticResource MaterialDesignFilledPasswordBox}"/>

                            <!-- Visible Password -->
                            <TextBox x:Name="txtPasswordVisible"
             Grid.Column="0"
             Height="45"
             Padding="10"
             FontSize="13"
FontWeight="SemiBold"
             Background="Transparent"
             BorderThickness="0"
             materialDesign:HintAssist.Hint="Password"
             Style="{StaticResource MaterialDesignFilledTextBox}"
             Visibility="Collapsed"/>

                            <Button Grid.Column="1"
            Background="Transparent"
            BorderThickness="0"
            Click="TogglePassword_Click">

                                <materialDesign:PackIcon x:Name="eyeIcon"
                                 Kind="EyeOutline"
                                 Width="18"
                                 Height="18"
                                 Foreground="Black"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Register Button -->
                    <Button Content="REGISTER"
                        Height="50"
                        Margin="0,25,0,10"
                        Background="#673AB7"
                        Foreground="White"
                        FontWeight="Bold"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="15"/>

                    <Button Content="Back to Login"
        Background="Transparent"
        BorderThickness="0"
        Foreground="DarkBlue"
        Cursor="Hand"
        Click="BackToLogin_Click"/>

                </StackPanel>
            </Border>

        </Grid>
    </Border>

</Window>