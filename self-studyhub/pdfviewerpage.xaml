<UserControl x:Class="self_studyhub.Pages.pdfviewerpage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:self_studyhub.Pages"
             xmlns:syncfusion="clr-namespace:Syncfusion.Windows.PdfViewer;assembly=Syncfusion.PdfViewer.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Top Toolbar -->
        <TextBlock x:Name="PdfPathText"
           Foreground="White"
           FontSize="18"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Background="#2D2D30" Height="50" VerticalAlignment="Top">
            <Button Content="Open PDF" Width="100" Margin="5" />
            <Button Content="Highlight" Width="100" Margin="5" />
            <Button Content="Add Note" Width="100" Margin="5" />
            <Button Content="Save" Width="100" Margin="5" />
        </StackPanel>

        <!-- Main Layout -->
        <Grid Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <TabControl Grid.Column="0" Background="#252526" Foreground="White">
                <TabItem Header="Thumbnails">
                    <ListBox x:Name="ThumbnailList" Background="#252526" Foreground="White"/>
                </TabItem>
                <TabItem Header="Bookmarks">
                    <ListBox x:Name="BookmarkList" Background="#252526" Foreground="White"/>
                </TabItem>
            </TabControl>

            <!-- PDF Viewer -->
            <syncfusion:PdfViewerControl x:Name="pdfViewer" Grid.Column="1" Background="White"/>
        </Grid>
    </Grid>
</UserControl>
