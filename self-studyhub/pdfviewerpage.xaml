<UserControl x:Class="self_studyhub.Pages.pdfviewerpage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"

    mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Main Layout -->
        </Grid.RowDefinitions>

        <!-- 🔹 Top Toolbar -->
        <StackPanel Orientation="Horizontal" Background="#2D2D30" Grid.Row="0">
            <Button Content="Open PDF" Width="100" Margin="5" Click="OpenPdf_Click"/>
            <Button Content="Highlight" Width="100" Margin="5" Click="Highlight_Click"/>
            <Button Content="Add Note" Width="100" Margin="5" Click="AddNote_Click"/>
            <Button Content="Save" Width="100" Margin="5,9,5,0" Click="Save_Click" VerticalAlignment="Top"/>
        </StackPanel>

        <!-- 🔹 Main Layout -->
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                
            </Grid.ColumnDefinitions>

            
            

            <!-- PDF Viewer -->
           
    </Grid>
    </Grid>
</UserControl>